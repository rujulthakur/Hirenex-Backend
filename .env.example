# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Data stores ----
MONGODB_URI=mongodb://127.0.0.1:27017/trusthire
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth (use 32+ random chars; never commit real values) ----
JWT_ACCESS_SECRET=change_me_access_secret_change_me_12345
JWT_REFRESH_SECRET=change_me_refresh_secret_change_me_1234
COOKIE_DOMAIN=
# lax for same-site local dev; none (with Secure) for Vercel -> Render cross-site
COOKIE_SAMESITE=lax

# ---- Role allow-list: comma-separated emails that sign in as role=interviewer (everyone else = hr_admin) ----
INTERVIEWER_EMAILS=

# ---- CORS: comma-separated allow-list of frontend origins ----
CORS_ORIGINS=http://localhost:5173

# ---- Google sign-in (optional until Prompt 4) ----
GOOGLE_CLIENT_ID=

# ---- Gmail SMTP: used ONLY for HR OTP email ----
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- LLM: gemini | groq ----
# BACKEND ONLY. Never put an API key in the frontend (anything VITE_* is public in the browser).
# Groq:   LLM_PROVIDER=groq,   GROQ_API_KEY=gsk_...,  LLM_MODEL=llama-3.3-70b-versatile
# Gemini: LLM_PROVIDER=gemini, GEMINI_API_KEY=...,    LLM_MODEL=gemini-2.0-flash
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ---- Demo + URLs ----
DEMO_MODE=false
APP_BASE_URL=http://localhost:4000
PORTAL_BASE_URL=http://localhost:5173
